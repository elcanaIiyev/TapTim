# Copy this file to `.env` and adjust as needed.

# Port the API listens on
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# Comma-separated list of origins allowed by CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Secret used to sign JWT access tokens. MUST be overridden in production.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Database (Supabase Postgres) — REQUIRED
# ---------------------------------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string → URI.
# Use the "Session pooler" string: it is IPv4-reachable, which the direct
# connection is not on most home and office networks.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# If the password contains @ : / ? # or %, percent-encode it.
DATABASE_URL=

# TLS mode for the database connection:
#   no-verify  encrypted, certificate chain not validated (default; what the
#              Supabase pooler expects without its root cert installed)
#   require    encrypted and chain-validated
#   disable    no TLS (local Postgres only)
DATABASE_SSL=no-verify
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Certificate verification (optional)
# ---------------------------------------------------------------------------
# With a key set, certificate claims are assessed by Claude. Without one, a
# deterministic rule-based verifier runs instead and the API works unchanged.
ANTHROPIC_API_KEY=
CERT_VERIFIER_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# App URL — where the SPA lives
# ---------------------------------------------------------------------------
# OAuth callbacks and email confirmation links bounce back here, so this must
# be the browser-facing origin, not the API's.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email confirmation (Resend)
# ---------------------------------------------------------------------------
# resend.com → API Keys. Without a key, signup still works and the confirmation
# link is printed to the API console instead of being emailed.
#
# The default sender (onboarding@resend.dev) needs no domain setup but can only
# deliver to the email address on your own Resend account. To email anyone else,
# verify a domain and set MAIL_FROM to an address on it.
RESEND_API_KEY=
MAIL_FROM=TapTim <onboarding@resend.dev>

# Whether a new account must confirm its address before it can be used.
#
# Off, deliberately. With the shared onboarding@resend.dev sender, the
# confirmation email only reaches the address that owns the Resend key, so
# turning this on locks out every user but one. Verify a domain in Resend, point
# MAIL_FROM at it, then set this to true — nothing else has to change.
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# OAuth sign-in
# ---------------------------------------------------------------------------
# Google:   console.cloud.google.com → APIs & Services → Credentials
#           → OAuth client ID → Web application
#   Authorised redirect URI: http://localhost:4000/api/auth/oauth/google/callback
#
# LinkedIn: linkedin.com/developers → your app → Auth
#           Products: request "Sign In with LinkedIn using OpenID Connect"
#   Redirect URL: http://localhost:4000/api/auth/oauth/linkedin/callback
#
# The redirect URI must match byte for byte or the provider rejects the sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Profile pictures (Supabase Storage)
# ---------------------------------------------------------------------------
# Supabase dashboard → Project Settings → API. Use the service_role key, not
# the anon key. The bucket is created automatically at boot if it is missing.
#
# service_role bypasses every storage policy — keep it server-side only and
# never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
